<?php
/*
 * Prepare the html code for the gallery. If a variant is selected and it has its own images,
 * we use them to create the gallery. If not, we use the product's images.
 */
$obj_tmp_productOrVariant = null;
if ($this->objProduct->_variantIsSelected && $this->objProduct->_selectedVariant->getImageGallery()->hasImages()) {
	$obj_tmp_productOrVariant = &$this->objProduct->_selectedVariant;
} else if ($this->objProduct->getImageGallery()->getImages()) {
	$obj_tmp_productOrVariant = &$this->objProduct;
}

// Fragment cache: only if we have a product/variant to render
if ($obj_tmp_productOrVariant !== null) {
    // Settings (reuse gallery cache settings)
    $enabled = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_enabled']) ? (bool)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_enabled'] : true;
    $ttlHours = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_ttlHours']) && (int)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_ttlHours'] > 0 ? (int)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_ttlHours'] : 6;
    $disableForBEUsers = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_disableForBEUsers']) ? (bool)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_disableForBEUsers'] : false;
    $warmOnBE = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_warmOnBE']) ? (bool)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_warmOnBE'] : true;
    $warmOnlyProd = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_warmOnlyProd']) ? (bool)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_warmOnlyProd'] : false;
    $exposeServerTiming = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_exposeServerTiming']) ? (bool)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_exposeServerTiming'] : false;
    $version = isset($GLOBALS['TL_CONFIG']['ls_shop_galleryCache_version']) && $GLOBALS['TL_CONFIG']['ls_shop_galleryCache_version'] !== '' ? (string)$GLOBALS['TL_CONFIG']['ls_shop_galleryCache_version'] : 'v1';

    $timeStart = microtime(true);
    $isBeUser = defined('BE_USER_LOGGED_IN') && \BE_USER_LOGGED_IN;
    $bypassRead = $disableForBEUsers && $isBeUser;

    // Build signature: language, product code, multiSRC list + mtimes, main image mtime, sort setting
    /** @var \Contao\PageModel $objPage */
    global $objPage;
    $lang = is_object($objPage) && isset($objPage->language) ? $objPage->language : 'xx';

    $gallery = $obj_tmp_productOrVariant->getImageGallery();
    $multiSRC = (array) $gallery->getMoreImagesUnprocessed();
    $mainSRC = $gallery->getMainImageUnprocessed();
    $sortBy = isset($GLOBALS['TL_CONFIG']['ls_shop_imageSortingStandardDirection']) ? (string)$GLOBALS['TL_CONFIG']['ls_shop_imageSortingStandardDirection'] : 'name_asc';

    $projectDir = \Contao\System::getContainer()->getParameter('kernel.project_dir');
    $sig = array();
    foreach ($multiSRC as $p) {
        $abs = $projectDir . '/' . $p;
        $sig[] = array('p' => $p, 'm' => is_file($abs) ? (int)@filemtime($abs) : 0);
    }
    $mainSig = null;
    if ($mainSRC) {
        $abs = $projectDir . '/' . $mainSRC;
        $mainSig = array('p' => $mainSRC, 'm' => is_file($abs) ? (int)@filemtime($abs) : 0);
    }

    $keySeed = json_encode(array(
        'v' => $version,
        'lang' => $lang,
        'prod' => $this->objProduct->_code,
        'isVariant' => (bool) $this->objProduct->_variantIsSelected,
        'sort' => $sortBy,
        'sig' => $sig,
        'mis' => $mainSig
    ));
    $cacheKey = 'merconis.gallery.fragment.' . sha1($keySeed);

    $useCache = $enabled && !$bypassRead;
    $shouldWarm = $enabled && ($warmOnBE && $isBeUser) && (!$warmOnlyProd || \Contao\System::getContainer()->getParameter('kernel.environment') === 'prod');

    if ($useCache) {
        try {
            $pool = \Contao\System::getContainer()->get('cache.app');
            $item = $pool->getItem($cacheKey);
            if ($item->isHit()) {
                $html = (string) $item->get();
                echo $html;
                if ($exposeServerTiming) {
                    $durMs = (microtime(true) - $timeStart) * 1000;
                    @header('Server-Timing: gallery-fragment;desc="cache-hit";dur=' . number_format($durMs, 1, '.', ''));
                }
                return;
            }
        } catch (\Throwable $t) {
            // ignore cache failures
        }
    }

    ob_start();
    ?>
    <div class="galleryContainer lsNavtabGalleryProductDetails">
        <?php
        foreach($obj_tmp_productOrVariant->getImageGallery()->getImages() as $image) {
            if (!is_object($image)) {
                continue;
            }

            ?>
            <div class="imageContainer">
                <a target="<?= (empty($image->originalSRC)) ?  '' : '_blank' ?>" class="<?= (empty($image->originalSRC)) ?  'lsjs-image-zoomer' : '' ?>" href="<?= (empty($image->originalSRC)) ?  $image->singleSRC : $image->originalSRC ?>" title="<?php echo $image->title ?>">
                    {{shop_picture::<?=$image->singleSRC?>?size=productDetailview&class=productImage&class=productImage}}
                </a>
            </div>
            <?php
        }
        ?>
    </div>

    <?php
    $html = ob_get_clean();

    // Store fragment (also when reads were bypassed but warming is allowed)
    if ($enabled && ($useCache || $shouldWarm)) {
        try {
            $pool = isset($pool) ? $pool : \Contao\System::getContainer()->get('cache.app');
            $item = isset($item) && $item->getKey() === $cacheKey ? $item : $pool->getItem($cacheKey);
            $item->set($html);
            $item->expiresAfter(max(1, (int)$ttlHours) * 3600);
            $pool->save($item);
        } catch (\Throwable $t) {
            // ignore
        }
    }

    echo $html;
    if ($exposeServerTiming) {
        $durMs = (microtime(true) - $timeStart) * 1000;
        $label = $enabled ? ($bypassRead ? 'bypass' : 'cache-miss') : 'disabled';
        @header('Server-Timing: gallery-fragment;desc="' . $label . '";dur=' . number_format($durMs, 1, '.', ''));
    }

    return;
}

// No gallery available
if ($obj_tmp_productOrVariant !== null) {
    ?>
    <div class="galleryContainer lsNavtabGalleryProductDetails"></div>
    <?php
}
?>