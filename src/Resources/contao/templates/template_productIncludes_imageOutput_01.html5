<?php
use LeadingSystems\MerconisBundle\Cache\MerconisCacheHandler;
/** Fragment cache: cache final rendered gallery HTML, skip for random sort. */
try {
    $container = Contao\System::getContainer();
    $fragmentCacheHandler = $container->has('merconis.cache_handler.fragment') ? $container->get('merconis.cache_handler.fragment') : null;
} catch (\Throwable $e) {
    $fragmentCacheHandler = null;
}
/*
 * Prepare the html code for the gallery. If a variant is selected and it has its own images,
 * we use them to create the gallery. If not, we use the product's images.
 */
$obj_tmp_productOrVariant = null;
if ($this->objProduct->_variantIsSelected && $this->objProduct->_selectedVariant->getImageGallery()->hasImages()) {
	$obj_tmp_productOrVariant = &$this->objProduct->_selectedVariant;
} else if ($this->objProduct->getImageGallery()->getImages()) {
	$obj_tmp_productOrVariant = &$this->objProduct;
}


if ($obj_tmp_productOrVariant !== null) {
    $sort = $obj_tmp_productOrVariant->getImageGallery()->getSortMode();
    $skipFragmentCache = ($sort === 'random');
    $cachedOutput = null;
    $handle = null;
    if ($fragmentCacheHandler && !$skipFragmentCache) {
        $prodId = $this->objProduct->_variantIsSelected ? $this->objProduct->_selectedVariant->_productVariantID : $this->objProduct->_productVariantID;
        $isVariant = (bool) $this->objProduct->_variantIsSelected;
        $sig = $this->objProduct->_variantIsSelected ? $obj_tmp_productOrVariant->getImageGallery()->getMultiSrcSignature() : $this->objProduct->getImageGallery()->getMultiSrcSignature();
        $mis = $this->objProduct->_variantIsSelected ? $obj_tmp_productOrVariant->getImageGallery()->getMainImageSignature() : $this->objProduct->getImageGallery()->getMainImageSignature();
        // Stable product-level overlays that affect HTML (e.g., badges)
        $ov = array();
        if ($this->objProduct->_isOnSale) { $ov[] = 'isOnSale'; }
        if ($this->objProduct->_isNew) { $ov[] = 'isNew'; }

        $params = array(
            'prod' => (string) $prodId,
            'isVariant' => $isVariant,
            'sort' => (string) $sort,
            'sig' => is_array($sig) ? $sig : array(),
            'mis' => $mis,
            'ov' => $ov,
        );
        $handle = $fragmentCacheHandler->createForRecipe('gallery_fragment', $params, 86400);
        $cachedOutput = $handle->startCapture();
        if ($cachedOutput !== null) {
            echo $cachedOutput;
            return;
        }
    }
    ?>
    <div class="galleryContainer lsNavtabGalleryProductDetails">
        <?php
        foreach($obj_tmp_productOrVariant->getImageGallery()->getImages() as $image) {
            if (!is_object($image)) {
                continue;
            }

            ?>
            <div class="imageContainer">
                <a target="<?= (empty($image->originalSRC)) ?  '' : '_blank' ?>" class="<?= (empty($image->originalSRC)) ?  'lsjs-image-zoomer' : '' ?>" href="<?= (empty($image->originalSRC)) ?  $image->singleSRC : $image->originalSRC ?>" title="<?php echo $image->title ?>">
                    {{shop_picture::<?=$image->singleSRC?>?size=productDetailview&class=productImage&class=productImage}}
                </a>
            </div>
            <?php
        }
        ?>
    </div>
    <?php if ($handle && !$skipFragmentCache) { echo $handle->finishCapture(); } ?>

    <?php
}
?>