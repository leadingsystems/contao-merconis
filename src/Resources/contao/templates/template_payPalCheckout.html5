<?php

use Contao\PageModel;
use Contao\System;
use Merconis\Core\ls_shop_languageHelper;
use Symfony\Component\Routing\Generator\UrlGeneratorInterface;

$ajaxId = (string) ls_shop_languageHelper::getLanguagePage('ls_shop_ajaxPages', false, 'id');

$pageModel = PageModel::findById($ajaxId);
$objContentUrlGenerator = System::getContainer()->get('contao.routing.content_url_generator');
$paymentApiUrl = $objContentUrlGenerator->generate($pageModel,array('parameters' => '/resource/paymentapipaypalcheckout'), UrlGeneratorInterface::ABSOLUTE_URL);

$defaultRequestToken = System::getContainer()->get('contao.csrf.token_manager')->getDefaultTokenValue();

?>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const paymentApiUrl = <?= json_encode($paymentApiUrl) ?>;
        const defaultRequestToken = <?= json_encode($defaultRequestToken) ?>;

        // --- Helper functions for the loading overlay ---
        const loadingIndicator = document.querySelector('.moduleContainer.loadingIndicator');
        const loadingOverlay = document.getElementById('loading-overlay');
        const loadingMessage = document.getElementById('loading-message');
        const errorMessageContainer = document.getElementById('payment-error-message');

        const showLoadingOverlay = (message) => {
            if (!loadingOverlay || !loadingMessage) {
                return;
            }

            loadingMessage.textContent = message || '';
            if(loadingIndicator){
                loadingIndicator.style.display = 'flex';
            }
            loadingOverlay.style.display = 'flex';
        };

        const hideLoadingOverlay = () => {
            if (!loadingOverlay) {
                return;
            }

            if(loadingIndicator){
                loadingIndicator.style.display = 'none';
            }
            loadingOverlay.style.display = 'none';
        };

        const updateLoadingMessage = (message) => {
            if (!loadingMessage) {
                return;
            }

            loadingMessage.textContent = message || '';
        };

        const updateErrorMessage = (message) => {
            if (!errorMessageContainer) {
                return;
            }

            errorMessageContainer.textContent = message || '';
        };

        // Helper function to wait for a certain amount of time
        const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));

        const paymentButton = document.querySelector('.buttonBuy');
        if (!paymentButton) {
            console.warn('PayPal Checkout: submit button (.buttonBuy) not found.');
            return;
        }

        const form = paymentButton.closest('form');
        if (!form) {
            console.warn('PayPal Checkout: submit button has no parent form.');
            return;
        }

        const requestTokenInput = form.querySelector('input[name="REQUEST_TOKEN"]');
        const requestToken = (requestTokenInput && requestTokenInput.value) ? requestTokenInput.value : defaultRequestToken;

        // --- Logic for payment processing when submitting the form ---
        form.addEventListener('submit', async (e) => {
            e.preventDefault();

            paymentButton.disabled = true;
            updateErrorMessage('');

            try {
                showLoadingOverlay('<?=$GLOBALS['TL_LANG']['MOD']['ls_shop']['paymentMethods']['payPalCheckout']['prepareOrder']?>');
                await wait(250);

                const body = new URLSearchParams({
                    function: 'finish-order',
                    REQUEST_TOKEN: requestToken,
                });

                const response = await fetch(paymentApiUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                    },
                    body: body.toString(),
                });

                if (!response.ok) {
                    throw new Error(`Payment API failed with HTTP ${response.status}`);
                }

                const result = await response.json();

                if (result.status === 'success' && result.data && result.data.approveUrl) {
                    updateLoadingMessage('<?=$GLOBALS['TL_LANG']['MOD']['ls_shop']['paymentMethods']['payPalCheckout']['preparePayment']?>');
                    await wait(250);

                    updateLoadingMessage('<?=$GLOBALS['TL_LANG']['MOD']['ls_shop']['paymentMethods']['payPalCheckout']['orderRedirectToFinishPage']?>');
                    await wait(250);

                    window.location.href = result.data.approveUrl;
                    return;
                }

                hideLoadingOverlay();
                updateErrorMessage('<?=$GLOBALS['TL_LANG']['MOD']['ls_shop']['paymentMethods']['payPalCheckout']['orderServerFailedMessage']?>');
            } catch (err) {
                hideLoadingOverlay();
                updateErrorMessage('<?=$GLOBALS['TL_LANG']['MOD']['ls_shop']['paymentMethods']['payPalCheckout']['orderServerErrorMessage']?>');
                console.error('Error in PayPal Checkout submit handler:', err);
            } finally {
                paymentButton.disabled = false;
            }
        });
    });
</script>