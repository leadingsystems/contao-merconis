<?php
use Contao\StringUtil;

$arrWithdrawalData = is_array($this->arrWithdrawal ?? null) ? $this->arrWithdrawal : [];
$intScenario = (int) ($arrWithdrawalData['scenario'] ?? 0);
$arrAddressFieldLabels = is_array($GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_address_field_labels'] ?? null)
    ? $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_address_field_labels']
    : [];
$formatAddressLines = static function ($serializedAddress) use ($arrAddressFieldLabels): string {
    $deserializedAddress = StringUtil::deserialize($serializedAddress);
    if (!is_array($deserializedAddress) || $deserializedAddress === []) {
        return '';
    }

    $flattenAddressLines = static function (array $addressData, array $addressFieldLabels, string $keyPrefix = '') use (&$flattenAddressLines): array {
        $lines = [];

        foreach ($addressData as $key => $value) {
            $lineKey = $keyPrefix;
            if (is_string($key) && !is_numeric($key)) {
                $lineKey = $lineKey ? $lineKey . '.' . $key : $key;
            }

            if (is_array($value)) {
                $lines = array_merge($lines, $flattenAddressLines($value, $addressFieldLabels, $lineKey));
                continue;
            }

            if ($value === null || $value === '') {
                continue;
            }

            $stringValue = trim((string) $value);
            if ($stringValue === '' || $stringValue === '-') {
                continue;
            }

            $lineLabel = $lineKey;
            if ($lineKey !== '' && array_key_exists($lineKey, $addressFieldLabels) && is_string($addressFieldLabels[$lineKey])) {
                $mappedLabel = trim($addressFieldLabels[$lineKey]);
                if ($mappedLabel === '') {
                    continue;
                }

                $lineLabel = $mappedLabel;
            }

            $lines[] = $lineLabel ? $lineLabel . ': ' . $stringValue : $stringValue;
        }

        return $lines;
    };

    return implode("\n", $flattenAddressLines($deserializedAddress, $arrAddressFieldLabels));
};
$formattedBillingAddress = $formatAddressLines($arrWithdrawalData['snapshotBillingAddress'] ?? null);
$formattedShippingAddress = $formatAddressLines($arrWithdrawalData['snapshotShippingAddress'] ?? null);
?>

<h3><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_heading']; ?></h3>

<?php if ($intScenario === 1) { ?>
	<table>
		<tbody>
			<tr>
				<th style="text-align: left;"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_order_number_label']; ?></th>
				<td><?php echo htmlspecialchars((string) ($arrWithdrawalData['snapshotOrderNr'] ?? ''), ENT_QUOTES); ?></td>
			</tr>
			<tr>
				<th style="text-align: left;"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_order_date_label']; ?></th>
				<td><?php echo htmlspecialchars((string) ($arrWithdrawalData['snapshotOrderDate'] ?? ''), ENT_QUOTES); ?></td>
			</tr>
			<?php if ($formattedBillingAddress !== '') { ?>
				<tr>
					<th style="text-align: left;"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_billing_address_heading']; ?></th>
					<td><?php echo nl2br(htmlspecialchars($formattedBillingAddress, ENT_QUOTES)); ?></td>
				</tr>
			<?php } ?>
			<?php if ($formattedShippingAddress !== '') { ?>
				<tr>
					<th style="text-align: left;"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_shipping_address_heading']; ?></th>
					<td><?php echo nl2br(htmlspecialchars($formattedShippingAddress, ENT_QUOTES)); ?></td>
				</tr>
			<?php } ?>
			<tr>
				<th style="text-align: left;"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_payment_method_label']; ?></th>
				<td><?php echo htmlspecialchars((string) ($arrWithdrawalData['snapshotPaymentMethod'] ?? ''), ENT_QUOTES); ?></td>
			</tr>
			<tr>
				<th style="text-align: left;"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_shipping_method_label']; ?></th>
				<td><?php echo htmlspecialchars((string) ($arrWithdrawalData['snapshotShippingMethod'] ?? ''), ENT_QUOTES); ?></td>
			</tr>
		</tbody>
	</table>
<?php } else { ?>
	<p><?php echo $GLOBALS['TL_LANG']['MSC']['ls_contao-merconis']['withdrawal_order_data_fallback']; ?></p>
<?php } ?>
