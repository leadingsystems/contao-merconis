<?php
/*
 * Button mit geöffneter Ansicht (LGN oder GARAN) über das Popover-Verhalten von HTML.
 *
 * Daten: `type` (`lgn` oder `garan`), `popoverId`, `triggerText` (Beschriftung, LGN) oder
 * `triggerLabel` und `nestedSvgMarkup` (Name und Nested Label, GARAN), `closeLabel`,
 * `unitMarkup` (gerenderte Einheit).
 */
?>
<div class="merconis-legal-guarantee-button merconis-legal-guarantee-button--<?= \Contao\StringUtil::specialchars($this->type) ?>">
    <button type="button" class="merconis-legal-guarantee-button__trigger" popovertarget="<?= \Contao\StringUtil::specialchars($this->popoverId) ?>"<?php if ('' !== $this->triggerLabel) { ?> aria-label="<?= \Contao\StringUtil::specialchars($this->triggerLabel) ?>"<?php } ?>><?php if ('' !== $this->nestedSvgMarkup) { ?><span class="merconis-legal-guarantee-button__nested"><?= $this->nestedSvgMarkup ?></span><?php } else { ?><?= \Contao\StringUtil::specialchars($this->triggerText) ?><?php } ?></button>
    <div id="<?= \Contao\StringUtil::specialchars($this->popoverId) ?>" popover class="merconis-legal-guarantee-button__popover">
        <button type="button" class="merconis-legal-guarantee-button__close" popovertarget="<?= \Contao\StringUtil::specialchars($this->popoverId) ?>" popovertargetaction="hide" aria-label="<?= \Contao\StringUtil::specialchars($this->closeLabel) ?>">×</button>
        <?= $this->unitMarkup ?>
    </div>
</div>
