<?php
	// use this to show the available output options:
	// echo $this->objProduct->_outputOptions;
?>
<div class="shopProduct <?php echo $this->productTemplateType; ?> <?php echo $this->productTemplate; ?> <?php echo $this->productPositionsClassString; ?> block">
	<div class="imageContainer">
		<?php if ($this->objProduct->_hasMainImage): ?>
			<a href="<?php echo $this->objProduct->_linkToProduct; ?>">
                <?= Contao\System::getContainer()->get('contao.insert_tag.parser')->replace('{{image::'.$this->objProduct->_mainImage.'?width=190&height=190&mode=box}}'); ?>
            </a>
		<?php endif; ?>
	</div>
	<h2><a href="<?php echo $this->objProduct->_linkToProduct; ?>"><?php echo $this->objProduct->_title; ?></a></h2>
	<div class="priceContainer">
		<div class="currentPrice">
			<?php if ($this->objProduct->_unscaledPricesAreDifferent): ?><?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['misc']['from']; ?> <?php endif; ?><?php echo $this->objProduct->_unscaledPriceMinimumAfterTaxFormatted; ?><?php if ($this->objProduct->_hasQuantityUnit): ?>/<?php echo $this->objProduct->_quantityUnit; ?><?php endif; ?>
		</div>
		<?php if ($this->objProduct->_hasOldPrice): ?>
			<?php
			$oldPriceOutput = ($this->objProduct->_oldPricesAreDifferent ? $GLOBALS['TL_LANG']['MSC']['ls_shop']['misc']['from'] . ' ' : '') . $this->objProduct->_priceOldMinimumAfterTaxFormatted;
			if ($this->objProduct->_hasQuantityUnit) {
				$oldPriceOutput .= '/' . $this->objProduct->_quantityUnit;
			}
			?>

			<?php if ($this->objProduct->_oldPriceIsUvp): ?>
				<div class="uvpPrice">
					<span class="label"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['misc']['uvp']; ?>:</span>
					<span class="value"><?php echo $oldPriceOutput; ?></span>
				</div>
			<?php else: ?>
				<div class="oldPrice">
					<?php echo $oldPriceOutput; ?>
				</div>
			<?php endif; ?>
		<?php endif; ?>

		<?php
		if (
			$this->objProduct->_has30DayLowestPrice
			&& !($this->objProduct->_hasOldPrice && $this->objProduct->_oldPriceIsUvp)
		) {
			$price30DayLowestOutput = ($this->objProduct->_30DayLowestPricesAreDifferent ? $GLOBALS['TL_LANG']['MSC']['ls_shop']['misc']['from'] . ' ' : '') . $this->objProduct->_price30DayLowestMinimumAfterTaxFormatted;
			$saving = max(0, $this->objProduct->_price30DayLowestMinimumAfterTax - $this->objProduct->_unscaledPriceMinimumAfterTax);
			$savingFormatted = \Merconis\Core\ls_shop_generalHelper::outputPrice($saving);
			?>
			<div class="thirtyDayLowestPriceInfo">
				<?php echo sprintf($GLOBALS['TL_LANG']['MSC']['ls_shop']['misc']['thirtyDayLowestPriceInfo'], $price30DayLowestOutput, $savingFormatted); ?>
			</div>
			<?php
		}
		?>
	</div>
</div>