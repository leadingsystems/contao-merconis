<!-- indexer::stop -->
<?php

use Contao\System;

$activeCount = (int) ($this->activeCount ?? 0);
$fastFilterAutoSubmit = !empty($this->fastFilterAutoSubmit);
$fastFilterHideZeroMatches = !empty($this->fastFilterHideZeroMatches);
$resetButtonClass = $activeCount > 0 ? '' : ' is-disabled';
$resetButtonDisabledAttributes = $activeCount > 0 ? '' : ' disabled aria-disabled="true"';
?>
<div class="filter-container fast-filter-container ls-filter-container template_fastFilterForm_default<?php echo $this->blnNothingToFilter ? ' nothingToFilter' : ' somethingToFilter'; ?>" data-fast-filter-root="1" data-active-count="<?php echo $activeCount; ?>" data-fast-filter-auto-submit="<?php echo $fastFilterAutoSubmit ? '1' : '0'; ?>" data-fast-filter-hide-zero-matches="<?php echo $fastFilterHideZeroMatches ? '1' : '0'; ?>">
    <button class="toggle-btn" id="toggleBtn"></button>

    <div id="fast-filter-headline-container" class="ajax-reload-by-filter" data-fast-filter-headline>
        <div class="filter-headline-bar">
            <h3 class="all-filter-options off-canvas-filter-form-toggler-remote">
                <?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['fastFilter']['filterHeadline']; ?>
            </h3>
            <?php if (!$this->blnNothingToFilter) { ?>
                <button
                    type="submit"
                    form="fast-filter-form"
                    class="filter-headline-reset<?php echo $resetButtonClass; ?>"
                    name="resetFastFilter"
                    value="1"
                    title="<?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['miscText106']; ?>"
                    aria-label="<?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['miscText106']; ?>"
                    <?php echo $resetButtonDisabledAttributes; ?>
                >
                    <?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['miscText106']; ?>
                </button>
            <?php } ?>
        </div>
    </div>

    <div id="fast-filter-content" class="fast-filter-content ls-filter ajax-reload-by-filter" data-fast-filter-content>
        <?php
        if (!$this->blnNothingToFilter) {
            ?>
            <form id="fast-filter-form" action="<?php echo $this->request; ?>" class="tl_form" method="post" data-fast-filter-form>
                <input type="hidden" name="REQUEST_TOKEN" value="<?= System::getContainer()->get('contao.csrf.token_manager')->getDefaultTokenValue() ?>">
                <input type="hidden" name="FORM_SUBMIT" value="fastFilterForm">

                <?php
                if (is_array($this->fields ?? null) && count($this->fields)) {
                    ?>
                    <div class="filter-fields fast-filter-fields" data-fast-filter-fields>
                        <?php
                        foreach ($this->fields as $field) {
                            $this->insert('template_fastFilterField_options', ['field' => $field]);
                        }
                        ?>
                    </div>
                    <div class="filter-submit-box fast-filter-submit-box">
                        <button type="submit" class="submit submitFilter submitFastFilter" name="submitFastFilter"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['miscText097']; ?></button>
                        <button type="submit" class="submit resetFilter resetFastFilter<?php echo $resetButtonClass; ?>" name="resetFastFilter" value="1"<?php echo $resetButtonDisabledAttributes; ?>><?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['miscText106']; ?></button>
                    </div>
                    <?php
                } else {
                    ?>
                    <p class="nothing-to-filter-notice"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['fastFilter']['empty']; ?></p>
                    <?php
                }
                ?>
            </form>
            <?php
        } else {
            ?>
            <p class="nothing-to-filter-notice"><?php echo $GLOBALS['TL_LANG']['MSC']['ls_shop']['fastFilter']['empty']; ?></p>
            <?php
        }
        ?>
    </div>
</div>
<!-- indexer::continue -->
