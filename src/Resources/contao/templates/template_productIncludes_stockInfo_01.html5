<?php
$obj_tmp_productOrVariant = null;
if ($this->objVariant !== null && $this->objVariant->_useStock) {
    $obj_tmp_productOrVariant = $this->objVariant;
} else if ($this->objProduct->_variantIsSelected && $this->objProduct->_selectedVariant->_useStock) {
	$obj_tmp_productOrVariant = $this->objProduct->_selectedVariant;
} else if (!$this->objProduct->_hasVariants && $this->objProduct->_useStock) {
	$obj_tmp_productOrVariant = $this->objProduct;
}

if ($obj_tmp_productOrVariant !== null) {
	?>
	<div class="stockInfo stockInfo-icon <?php echo $obj_tmp_productOrVariant->_stockIsInsufficient ? ' error-all' : ' success-all'  ?>"><p><?php echo sprintf($GLOBALS['TL_LANG']['MSC']['ls_shop']['misc']['stockAvailable'], \Merconis\Core\ls_shop_generalHelper::outputDisplayQuantity($obj_tmp_productOrVariant->_stock, (int) $obj_tmp_productOrVariant->_quantityDecimals, (int) $obj_tmp_productOrVariant->_salesUnitSize), $obj_tmp_productOrVariant->_salesUnit); ?></p></div>
	<?php
}
?>