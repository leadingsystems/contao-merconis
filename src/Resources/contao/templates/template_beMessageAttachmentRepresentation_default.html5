<div class="messagesSentAttachments">
<?php
	if (!is_array($this->value)) {
		$this->value = \Contao\StringUtil::deserialize($this->value);
	}
	
	if (is_array($this->value)) {
		?>
		<ul>
		<?php
		foreach ($this->value as $v) {
			$href = (string) $v;
			if ($href !== '' && !preg_match('/^(https?:)?\/\//', $href) && !str_starts_with($href, '/')) {
				$href = '/' . ltrim($href, '/');
			}
			?>
			<li><a href="<?php echo htmlspecialchars($href, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?>" target="_blank" rel="noreferrer noopener"><?php echo htmlspecialchars((string) $v, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8'); ?></a></li>
			<?php
		}
		?>
		</ul>
		<?php
	}
?>
</div>