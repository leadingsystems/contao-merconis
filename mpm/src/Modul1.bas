alterEnableEventsStatus = aktuellerEnableEventsStatus
alterScreenUpdateingStatus = aktuellerScreenUpdatingStatus
If Application.Calculation = xlCalculationAutomatic Then alterCalculationAutomaticStatus = True
Application.EnableEvents = False
Application.ScreenUpdating = False
Application.Calculation = xlCalculationManual

feld = LCase(feld)
Select Case feld
Case "parentproductcode", "" 'Formel für übergeordneten Artikelnummern hinterlegen (aber nur, wenn der Modus stimmt)
    If Range(modusÜbergeordneteArtikelnummerEmittelnZelle) = "automode" Then 'Nur, wenn Auto-Modus für die Ermittlung der übergeordneten Artikelnummer
        Dim aktuelleZeile As Long
        Dim X As Long
        aktiviereTabellenblatt zentralwertTabellenblattNameProduktverwaltung
        'Diese Formel befindet sich in der Zelle 'formelÜbergeordneteArtikelnummer' und muss aber als Matrixformel {} eingegeben werden (also mit STRG+SHIFT+ENTER)
        '=IF($E9<>"",IF(OR($E9=mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Variant"),$E9=mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Product (foreign language)")),INDIRECT(ADDRESS(10+(MATCH(2,1/($E9:$E$11=mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Product")))),6)),IF($E9=mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Variant (foreign language)"),INDIRECT(ADDRESS(10+(MATCH(2,1/($E9:$E$11=mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Variant")))),6)),"")),"")
        Range(formelÜbergeordneteArtikelnummer).Copy
        For X = zentralwertZeileDatenbeginn To letzteVerwendeteZeile
            If Not Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer).HasFormula Then
                Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer).PasteSpecial Paste:=xlPasteFormulas, Operation:=xlNone, SkipBlanks:=False, Transpose:=False
            End If
        Next X
    End If
    Application.Calculate 'Excel anweisen, die Formeln neu zu berechnen
End Select

exitHandler:
Application.EnableEvents = alterEnableEventsStatus
Application.ScreenUpdating = alterScreenUpdateingStatus
If alterCalculationAutomaticStatus = True Then Application.Calculation = xlCalculationAutomatic
Application.CutCopyMode = False
Range(letzteAktiveZelle).Select
Exit Sub

errHandler:
MsgBox "Error: " & aktuelleFunktionsnummer, vbOKOnly
GoTo exitHandler
End Sub


Public Sub parentProductCodeManuellNeuSetzen()
'Setzt überall die übergordnete Artikelnummer
aktuelleFunktionsnummer = crc32HashErmitteln("parentProductCodeManuellNeuSetzen")
On Error GoTo errHandler
Application.EnableCancelKey = xlDisabled

Dim alterEnableEventsStatus As Boolean
Dim alterScreenUpdateingStatus As Boolean
Dim alterCalculationAutomaticStatus As Boolean
alterEnableEventsStatus = aktuellerEnableEventsStatus
alterScreenUpdateingStatus = aktuellerScreenUpdatingStatus
If Application.Calculation = xlCalculationAutomatic Then alterCalculationAutomaticStatus = True
Application.EnableEvents = False
Application.ScreenUpdating = False
Application.Calculation = xlCalculationManual

Dim aktuellerTyp As String
Dim X As Long
Dim aktuelleProduktnummer As String
Dim aktuelleVariantennummer As String
Dim bezProduktTyp_Product As String
Dim bezProduktTyp_Variant As String
Dim bezProduktTyp_ProductForeignLanguage As String
Dim bezProduktTyp_VariantForeignLanguage As String
Dim statusUpdateZähler As Long

bezProduktTyp_Product = mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Product")
bezProduktTyp_Variant = mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Variant")
bezProduktTyp_ProductForeignLanguage = mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Product (foreign language)")
bezProduktTyp_VariantForeignLanguage = mehrsprachigkeitBegriffsrückgabe(gewählteSpracheZurückgeben(), "Variant (foreign language)")

'Für die Produktverwaltung die Datenüberprüfungen wieder frisch setzen
aktiviereTabellenblatt zentralwertTabellenblattNameProduktverwaltung
For X = zentralwertZeileDatenbeginn To letzteVerwendeteZeile
    aktuellerTyp = Cells(X, zentralwertProduktverwaltungSpalteTyp)
    Select Case aktuellerTyp
    Case bezProduktTyp_Product
    aktuelleProduktnummer = Cells(X, zentralwertProduktverwaltungSpalteArtikelnummer)
    Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer) = ""
    Case bezProduktTyp_Variant
    aktuelleVariantennummer = Cells(X, zentralwertProduktverwaltungSpalteArtikelnummer)
    Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer) = aktuelleProduktnummer
    Case bezProduktTyp_ProductForeignLanguage
    Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer) = aktuelleProduktnummer
    Case bezProduktTyp_VariantForeignLanguage
    Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer) = aktuelleVariantennummer
    Case Else
    Cells(X, zentralwertProduktverwaltungSpalteÜbergeordneteArtikelnummer) = ""
    End Select
    'Status im WaitFenster aktualisieren
    WaitFenster.LabelInfotext.Caption = mehrsprachigkeitTextrückgabeAktuelleSprache(aktuellGewählteSprache, "wait") & vbLf & vbLf & mehrsprachigkeitTextrückgabeAktuelleSprache(aktuellGewählteSprache, "csvVerarbeiteteZeilen") & letzteVerwendeteZeile - X
    statusUpdateZähler = statusUpdateZähler + 1
    If statusUpdateZähler = 100 Or X >= letzteVerwendeteZeile - 100 Then
        warteschleife 0.01, True
        WaitFenster.Repaint
        statusUpdateZähler = 0
    End If
Next X

GoTo exitHandler

exitHandler:
Application.EnableEvents = alterEnableEventsStatus
Application.ScreenUpdating = alterScreenUpdateingStatus
If alterCalculationAutomaticStatus = True Then Application.Calculation = xlCalculationAutomatic
Range(letzteAktiveZelle).Select
Exit Sub

errHandler:
MsgBox "Error: " & aktuelleFunktionsnummer, vbOKOnly
GoTo exitHandler
End Sub




