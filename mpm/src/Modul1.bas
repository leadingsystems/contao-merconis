Public Sub zentraleVariablen1()

aktuelleFunktionsnummer = crc32HashErmitteln("zentraleVariablen1")
On Error GoTo errHandler
Application.EnableCancelKey = xlDisabled


zentralwertExcelVersion = Val(Application.Version)
zentralwertAltesExcelVorVersion = 12 'Bis zu dieser Version handelt es sich um eine 'alte' Excel-Version
zentralwertZeileKopfbereichende = 2
zentralwertZeileVersteckteWerte = 6
zentralwertZeileProdukttypen = 7
zentralwertZeileSpaltentyp = 8
zentralwertZeileExportbeginn = 9
zentralwertZeileDatenbanknamen = 10
zentralwertZeileÜberschriften = 11
zentralwertZeileDatenbeginn = 12

zentralwertMaxArtikelzeilen = maxMöglicheZeilenanzahl - zentralwertZeileDatenbeginn

'Sprache hier setzen sowie Tabellennamen zu Beginn setzen, da ansonsten bei Programmstart ein Fehler kommt.
aktuellGewählteSprache = 2
mehrsprachigkeitTabellenNamenÄndern

letzteAktiveZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("letzteAktiveZelle").Address

gewählteSpracheZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("gewaehlteSprache").Address
If IsEmpty(Range(gewählteSpracheZelle)) Or Range(gewählteSpracheZelle) = 0 Then Range(gewählteSpracheZelle) = 1
aktuellGewählteSprache = gewählteSpracheZurückgeben()

seitenwählerZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("seitenwaehler").Address
If IsEmpty(Range(seitenwählerZelle)) Or Range(seitenwählerZelle) = 0 Then Range(seitenwählerZelle) = 1

aktionswählerZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("aktionswaehler").Address
If IsEmpty(Range(seitenwählerZelle)) Or Range(seitenwählerZelle) = 0 Then Range(seitenwählerZelle) = 1

kopfbereichAusblendenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("kopfbereichAusblenden").Address

merkmaleAusprägungenAusblendenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("merkmaleAuspraegungenAusblenden").Address

staffelpreiseAusblendenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("staffelpreiseAusblenden").Address

gruppenpreiseAusblendenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("gruppenpreiseAusblenden").Address

formelÜbergeordneteArtikelnummer = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("formelUebergeordneteArtikelnummer").Address

modusÜbergeordneteArtikelnummerEmittelnZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("modusUebergeordneteArtikelnummerEmitteln").Address

formelLokalTemporärUmwandelnZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("formelLokalTemporaerUmwandeln").Address

kategorienAuswaehlenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("kategorienAuswaehlen").Address

variantenAlleAusblendenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("variantenAlleAusblenden").Address

zentralwertMakrohinweisZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("zentralwertMakrohinweis").Address

flexContentAusblendenZelle = Sheets(zentralwertTabellenblattNameProduktverwaltung).Range("flexContentAusblenden").Address

'Anführungszeichen in Variable merken
zeichen_gf = Chr(34)

'Sprachen in Array merken
mehrsprachigkeitSprachen(1) = "Englisch"
mehrsprachigkeitSprachen(2) = "Deutsch"

'Anzahl Zeilen im Sheet 1 merken (nötig für Prüfung bei Einfügen oder Löschen von ganzen Zeilen und der Aktulisierung der bedingten Formatierungen)
ActiveSheet.UsedRange
letzteVerwendeteZeileZuvor = ActiveSheet.UsedRange.Rows.Count

exitHandler:
Exit Sub

errHandler:
MsgBox "Error: " & aktuelleFunktionsnummer, vbOKOnly
MsgBox "Fehler in zentraleVariablen1", vbOKOnly
GoTo exitHandler

End Sub


