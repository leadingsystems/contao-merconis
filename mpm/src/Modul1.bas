Public Sub trennspaltenFormatieren()
'Bei den Spalten, die lediglich eine optische Trennung bewirken sollen (Spaltentyp="T"), werden die bedingten Formatierungen gelöscht.

aktuelleFunktionsnummer = crc32HashErmitteln("trennspaltenFormatieren")
On Error GoTo errHandler

Dim bereich As Variant
Dim zelle As Range
bereich = zentralwertZeileSpaltentyp & ":" & zentralwertZeileSpaltentyp
For Each zelle In Sheets(zentralwertTabellenblattNameProduktverwaltung).Range(bereich)
    If zelle = "T" Then
        Range(Columns(zelle.Column), Columns(zelle.Column)).FormatConditions.Delete
        Range(Columns(zelle.Column), Columns(zelle.Column)).Interior.Color = 12566463
        Range(Cells(1, zelle.Column).Address, Cells(zentralwertZeileÜberschriften - 7, zelle.Column).Address).Interior.Color = xlNone
        'Range(Columns(zelle.Column), Columns(zelle.Column)).ColumnWidth = 2
    End If
Next

exitHandler:
Exit Sub

errHandler:
MsgBox "Error: " & aktuelleFunktionsnummer, vbOKOnly
GoTo exitHandler

End Sub

Public Sub datenüberprüfungNeuSetzen(Optional einzelnesFeld As Long)
'Für jede Spalte wird die Datenüberprüfung neu gesetzt. Wichtig bei Import/Update von Daten, da dann die Datenüberprüfung fehlerhaft ist (enthält Verweise auf die Quell-Excel-Datei).

aktuelleFunktionsnummer = crc32HashErmitteln("datenüberprüfungNeuSetzen")
On Error GoTo errHandler
Application.EnableCancelKey = xlDisabled

Dim alterEnableEventsStatus As Boolean
Dim alterScreenUpdateingStatus As Boolean
alterEnableEventsStatus = aktuellerEnableEventsStatus
alterScreenUpdateingStatus = aktuellerScreenUpdatingStatus
Application.EnableEvents = False
Application.ScreenUpdating = False
                                                    
                                                    
                                                    

Dim letzteSpalteProduktverwaltung As Long
Dim letzteZeileProduktverwaltung As Long
Dim letzteSpalteKonfiguration As Long
Dim letzteZeileKonfiguration As Long
Dim letzteSpalteBasisparameter As Long
Dim letzteZeileBasisparameter As Long
Dim spaltenzähler As Long
Dim aktSpalteName As String
Dim datenüberprüfungFormelSetzen As Boolean
Dim datenüberprüfungDeaktivieren As Boolean
Dim formel As String
Dim aktivesTabellenblattZuvor As Long
aktivesTabellenblattZuvor = aktuellAktiviertesTabellenblatt

'Die Datenüberprüfungen aller Tabellenblätter löschen (aber nur, wenn Datenüberprüfung nicht explizit für ein spezielles Feld vorgenommen werden soll)
If einzelnesFeld = 0 Then
    Sheets(zentralwertTabellenblattNameProduktverwaltung).Cells.Validation.Delete
    Sheets(zentralwertTabellenblattNameKonfiguration).Cells.Validation.Delete
    Sheets(zentralwertTabellenblattNameBasisparameter).Cells.Validation.Delete
    Sheets(zentralwertTabellenblattNameProduktverwaltung).Cells.Validation.Delete
End If


letzteSpalteProduktverwaltung = letzteVerwendeteSpalteErmitteln(zentralwertTabellenblattNameProduktverwaltung)
letzteZeileProduktverwaltung = zentralwertMaxArtikelzeilen
letzteSpalteKonfiguration = letzteVerwendeteSpalteErmitteln(zentralwertTabellenblattNameKonfiguration)
letzteZeileKonfiguration = zentralwertMaxArtikelzeilen
letzteSpalteBasisparameter = letzteVerwendeteSpalteErmitteln(zentralwertTabellenblattNameBasisparameter)
letzteZeileBasisparameter = letzteVerwendeteZeileErmitteln(zentralwertTabellenblattNameBasisparameter)

'Für die Produktverwaltung die Datenüberprüfungen wieder frisch setzen
aktiviereTabellenblatt zentralwertTabellenblattNameProduktverwaltung

For spaltenzähler = 1 To letzteSpalteProduktverwaltung

    aktSpalteName = Cells(zentralwertZeileÜberschriften, spaltenzähler)
    
    'Je nach Feld eine andere Formel hinterlegen
    If aktSpalteName <> "" And (spaltenzähler = einzelnesFeld Or einzelnesFeld = 0) Then 'Überspringen, wenn leere Spalte
        With Range(Cells(zentralwertZeileDatenbeginn, spaltenzähler).Address & ":" & Cells(letzteZeileProduktverwaltung, spaltenzähler).Address).Validation
            datenüberprüfungFormelSetzen = False
            datenüberprüfungDeaktivieren = False
            Select Case spaltenzähler
                'Hier werden das Tabellenblatt 'Basisparameter' verarbeitet
                
                'Wenn Spalte = 'Importsperre'
                Case zentralwertProduktverwaltungSpalteImportsperre
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteImportsperre).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteImportsperre).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterImportsperre"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Löschen'
                Case zentralwertProduktverwaltungSpalteLöschen
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteLöschen).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteLöschen).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterLöschen"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Veröffentlichen'
                Case zentralwertProduktverwaltungSpalteVeröffentlichen
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                
                    'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" _
                        & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, _
                        Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteVeröffentlichen).Address & ":" _
                        & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteVeröffentlichen).Address)
                Else
                    formel = "=" & "basisparameterVeröffentlichen"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Typ'
                Case zentralwertProduktverwaltungSpalteTyp
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteTyp).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteTyp).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterTyp"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Preis: Art der Preisangabe'
                Case zentralwertProduktverwaltungSpaltePreisTyp, zentralwertProduktverwaltungSpaltePreisTypGruppe1, zentralwertProduktverwaltungSpaltePreisTypGruppe2, zentralwertProduktverwaltungSpaltePreisTypGruppe3, zentralwertProduktverwaltungSpaltePreisTypGruppe4, zentralwertProduktverwaltungSpaltePreisTypGruppe5
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpaltePreisTyp).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpaltePreisTyp).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterPreisart"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Staffelpreis anwenden'
                Case zentralwertProduktverwaltungSpalteStaffelpreisAnwenden, zentralwertProduktverwaltungSpalteStaffelpreisAnwendenGruppe1, zentralwertProduktverwaltungSpalteStaffelpreisAnwendenGruppe2, zentralwertProduktverwaltungSpalteStaffelpreisAnwendenGruppe3, zentralwertProduktverwaltungSpalteStaffelpreisAnwendenGruppe4, zentralwertProduktverwaltungSpalteStaffelpreisAnwendenGruppe5
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteStaffelpreisAnwenden).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteStaffelpreisAnwenden).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterStaffelpreisAnwenden"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Staffelpreis Art'
                Case zentralwertProduktverwaltungSpalteStaffelpreisArt, zentralwertProduktverwaltungSpalteStaffelpreisArtGruppe1, zentralwertProduktverwaltungSpalteStaffelpreisArtGruppe2, zentralwertProduktverwaltungSpalteStaffelpreisArtGruppe3, zentralwertProduktverwaltungSpalteStaffelpreisArtGruppe4, zentralwertProduktverwaltungSpalteStaffelpreisArtGruppe5
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteStaffelpreisArt).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteStaffelpreisArt).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterStaffelpreisArt"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Staffelpreis Methode der Mengenermittlung'
                Case zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungMethode, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungMethodeGruppe1, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungMethodeGruppe2, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungMethodeGruppe3, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungMethodeGruppe4, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungMethodeGruppe5
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteStaffelpreisMengenermittlungMethode).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteStaffelpreisMengenermittlungMethode).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterStaffelpreisMengenermittlungMethode"
                End If
                datenüberprüfungFormelSetzen = True
                'Wenn Spalte = 'Staffelpreis unterschiedliche Konfigurationen immer trennen'
                Case zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungKonfigurationenTrennen, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungKonfigurationenTrennenGruppe1, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungKonfigurationenTrennenGruppe2, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungKonfigurationenTrennenGruppe3, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungKonfigurationenTrennenGruppe4, zentralwertProduktverwaltungSpalteStaffelpreisMengenermittlungKonfigurationenTrennenGruppe5
                If zentralwertExcelVersion >= zentralwertAltesExcelVorVersion Then
                    formel = "=" & zentralwertTabellenblattNameBasisparameter & "!" & zellbereichLeerzeilenKappen(zentralwertTabellenblattNameBasisparameter, Cells(zentralwertZeileDatenbeginn, zentralwertBasisparameterSpalteStaffelpreisMengenermittlungKonfigurationenTrennen).Address & ":" & Cells(letzteZeileBasisparameter, zentralwertBasisparameterSpalteStaffelpreisMengenermittlungKonfigurationenTrennen).Address) 'Bereich für diese Spalte ermitteln. Dieser wird für die Datenprüfungs-Formel verwendet
                Else
                    formel = "=" & "basisparameterStaffelpreisMengenermittlungKonfigurationenTrennen"
                End If
